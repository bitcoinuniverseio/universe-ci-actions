[Unit]
Description=Universe ephemeral GitHub Actions runner (one job, then power off)
After=network-online.target docker.service google-guest-agent.service
Wants=network-online.target docker.service
ConditionPathExists=/opt/actions-runner/run.sh

[Service]
Type=simple
# Jobs inherit this environment. ~/.local/bin (pip --user, poetry) and cargo
# match GitHub-hosted images; CHROME_PATH lets Lighthouse and chrome-launcher
# find the baked Chromium without a download.
Environment=PATH=/home/runner/.local/bin:/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CHROME_PATH=/usr/local/bin/google-chrome
Environment=PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ExecStart=/opt/universe-runner/bootstrap.sh
Restart=no
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
